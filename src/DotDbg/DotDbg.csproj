<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>dotdbg</ToolCommandName>
        <PackageId>DotDbg</PackageId>
        <Version>0.0.0-local</Version>
        <Authors>Akito Inoue</Authors>
        <Description>Command-line debugger for managed .NET programs, designed for AI agents and terminal users.</Description>
        <PackageTags>dotnet;debugger;cli;ai-agent</PackageTags>
        <PackageProjectUrl>https://github.com/akeit0/dotdbg</PackageProjectUrl>
        <RepositoryUrl>https://github.com/akeit0/dotdbg</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RollForward>Major</RollForward>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Diagnostics.DbgShim" Version="10.0.745401" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\docs\nuget-readme.md" Pack="true" PackagePath="README.md" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="/" />
        <None
            Include="..\..\sharpdbg\LICENSE.txt"
            Pack="true"
            PackagePath="ThirdPartyLicenses/SharpDbg.LICENSE.txt"
        />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\sharpdbg\src\SharpDbg.Infrastructure\SharpDbg.Infrastructure.csproj" />
    </ItemGroup>
</Project>
